{
  "name": "errejota",
  "version": "1.4.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:news": "tsx src/db/fetch-news.ts",
    "db:cameras": "tsx scripts/import-cameras.ts",
    "db:rain": "tsx scripts/sync-rain.ts",
    "db:risk": "tsx scripts/sync-risk.ts",
    "db:status": "tsx scripts/check-camera-status.ts",
    "db:sync": "tsx scripts/sync-db-from-production.ts",
    "db:local": "tsx scripts/setup-local-db.ts && npm run db:seed && npm run db:cameras -- --replace",
    "db:setup": "npm run db:push && npm run db:seed && npm run db:cameras -- --replace",
    "db:migrate-reports": "tsx scripts/migrate-reports.ts",
    "db:drop-legacy": "tsx scripts/drop-legacy-tables.ts",
    "db:migrate-safety": "tsx scripts/migrate-safety.ts",
    "db:safety": "tsx scripts/sync-safety.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@next/env": "^16.4.3",
    "@vercel/analytics": "^2.0.1",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.12.1",
    "lucide-react": "^1.66.0",
    "maplibre-gl": "^6.16.0",
    "next": "16.4.6",
    "postgres": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@esbuild-kit/esm-loader": {
      "@esbuild-kit/core-utils": {
        "esbuild": "^0.25.0"
      }
    }
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@emnapi/wasi-threads": "^1.2.3",
    "@napi-rs/wasm-runtime": "^1.2.2",
    "@tailwindcss/turbopack": "^4",
    "@tybys/wasm-util": "^0.10.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
