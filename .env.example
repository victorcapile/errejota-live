DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres?workaround=supabase-pooler.vercel&sslmode=require
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opcional: protege POST /api/cameras/status e /api/cameras/status/manual em produção.
# CAMERA_STATUS_TOKEN=

# Salt para pseudonimizar IPs nas métricas de uso e localização.
# IP_HASH_SALT=uma-string-longa-e-aleatoria

# Segredo do cron diário que apaga localizações antigas e eventos com mais de 12 meses.
# CRON_SECRET=uma-string-longa-e-aleatoria

# Admin: login por usuário/senha e allowlist de IP.
# ADMIN_USER=admin
# ADMIN_PASSWORD=troque-esta-senha
# ADMIN_SESSION_SECRET=uma-string-longa-e-aleatoria
# Lista de IPs públicos autorizados a ver e acessar /admin, separados por vírgula.
# Localhost é sempre permitido. Use o IP de saída do seu computador.
# ADMIN_ALLOWED_IPS=203.0.113.10

# GitHub Actions: cadastre DATABASE_URL nos secrets do repositório para a ingestão agendada (chuva/risco).
